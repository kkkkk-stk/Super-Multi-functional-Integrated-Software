{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolForge",
  "mainBinaryName": "toolforge",
  "version": "0.1.0",
  "identifier": "com.toolforge.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ToolForge",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "theme": null,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**", "$DOWNLOAD/**", "$PICTURE/**", "$VIDEO/**", "$AUDIO/**", "$DOCUMENT/**", "$DESKTOP/**"]
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "插件驱动的集成式多功能工具箱",
    "longDescription": "ToolForge 把图片 / 音视频 / 文档 / 压缩包 / 电子书处理整合到一个界面里，并支持用自然语言生成插件来扩展能力。所有能力引擎按需下载、可降级，核心功能完全离线。",
    "copyright": "MIT Licensed",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../plugins/builtin": "plugins/builtin"
    },
    "externalBin": [],
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
