# ================= 构建产物 =================
build/
dist/
out/
target/
*.exe
*.dll
*.so
*.dylib
*.msi
*.app
# TypeScript 增量编译缓存（tsc --noEmit 也会生成）
*.tsbuildinfo
.vite/

# ================= 依赖目录 =================
node_modules/
vendor/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# ================= ToolForge 专属 =================
# 按需下载的引擎二进制 / 模型权重，绝不入库
/engines/
/models/
/apps/desktop/src-tauri/engines/
/apps/desktop/src-tauri/models/

# 插件构建产物（WASM / Python 打包）
plugins/**/target/
plugins/**/*.wasm
plugins/**/dist/
plugins/**/.venv/

# 本地工具链隔离目录（沙箱 / CI 用）
.tools/
.cache/

# 本地 AI / 编辑器插件的工作目录（`.workbuddy/memory/*.md` 这类）。
# 它不是这个项目的产物，也不是任何构建会读的输入 —— 是**某个本地工具**自己写的
# 笔记（内容是它对这份仓库的评述）。留在工作区里会让 `git status` 一直不干净，
# 一个 `git add -A` 就会把它混进项目历史，读历史的人会以为它是项目文件。
# 需要保留的话它仍然在磁盘上，只是不进版本库。
.workbuddy/

# `pnpm icons` 的移动端产物。本项目是**桌面**应用 —— `bundle.targets = "all"`
# 指的是 Windows / macOS / Linux 三套**桌面**打包，不含 android / ios，
# 这两棵树没有任何构建会去读。它们仍会被 `pnpm icons` 照常生成，只是不入库：
# 入库只会让仓库凭空多出几十个永远用不到的 PNG。
# 桌面真正要用的那几个（32x32 / 128x128 / 128x128@2x / icon.ico / icon.icns /
# StoreLogo / Square*Logo）**是入库的**，见 `tauri.conf.json` 的 `bundle.icon`。
/apps/desktop/src-tauri/icons/android/
/apps/desktop/src-tauri/icons/ios/

# 前端自动生成的 TS 绑定**要入库**（见 .gitignore 末尾说明），此处不忽略
# apps/desktop/src/bindings.ts

# ================= IDE / 编辑器 =================
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

